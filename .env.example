# Blooking — local environment variables
# Copy to `.env` and adjust as needed: `cp .env.example .env`

# --- PostgreSQL ---
POSTGRES_DB=blooking
POSTGRES_USER=blooking
POSTGRES_PASSWORD=blooking
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=blooking
RABBITMQ_PASSWORD=blooking
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Ollama (embeddings) ---
OLLAMA_PORT=11434
EMBEDDING_MODEL=bge-m3
# When the backend runs OUTSIDE docker (e.g. ./mvnw spring-boot:run on the host),
# it reaches the containerized Ollama at http://localhost:11434.
# When the backend runs INSIDE docker and Ollama runs natively on the host,
# use http://host.docker.internal:11434 instead.
OLLAMA_BASE_URL=http://localhost:11434
