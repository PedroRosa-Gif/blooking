# Blooking — local environment variables
# Copy to `.env` and adjust as needed: `cp .env.example .env`

# --- PostgreSQL ---
POSTGRES_DB=blooking
POSTGRES_USER=blooking
POSTGRES_PASSWORD=blooking
POSTGRES_PORT=5432

# --- RabbitMQ ---
RABBITMQ_USER=blooking
RABBITMQ_PASSWORD=blooking
RABBITMQ_PORT=5672
RABBITMQ_MGMT_PORT=15672

# --- Ollama (embeddings) ---
OLLAMA_PORT=11434
EMBEDDING_MODEL=bge-m3
# When the backend runs OUTSIDE docker (e.g. ./mvnw spring-boot:run on the host),
# it reaches the containerized Ollama at http://localhost:11434.
# When the backend runs INSIDE docker and Ollama runs natively on the host,
# use http://host.docker.internal:11434 instead.
OLLAMA_BASE_URL=http://localhost:11434

# --- Auth / JWT ---
# HS256 signing secret — use a long random value (>= 32 bytes). Dev default is
# set in application.yml; override here/in your environment for anything real.
JWT_SECRET=dev-only-insecure-secret-change-me-min-32-bytes!!
JWT_ACCESS_EXPIRATION_MS=900000      # 15 minutes
JWT_REFRESH_EXPIRATION_MS=604800000  # 7 days
# Comma-separated list of allowed CORS origins (the frontend origin).
CORS_ALLOWED_ORIGINS=http://localhost:5173
